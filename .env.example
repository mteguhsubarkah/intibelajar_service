NODE_ENV=development
DATABASE_URL=postgresql://slice0:REPLACE@127.0.0.1:55432/intibelajar_slice0_dev
APP_ORIGIN=http://localhost:5173
APP_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
SYNTHETIC_FIXTURES=false
HOST=127.0.0.1
PORT=8000
# Onboarding mandiri: setelah username + kelas diisi, siswa memberi izin sendiri
# (LEARNING_DATA, AI_PROCESSING, IMAGE_UPLOAD) tanpa guardian. false = alur guardian.
SELF_ONBOARDING_CONSENT=false
# Daftar + masuk dengan username & password (email verifikasi lewat outbox). Nyalakan bersama
# VITE_PASSWORD_SIGNIN=true di build FE. Butuh migrasi 0014 dan pengirim email (atau alamat .invalid lokal).
FEATURE_PASSWORD_AUTH=false
# Email masuk sungguhan (lihat .env.email.example). Kosong = hanya kotak surat sintetis lokal.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_REPLACE
# EMAIL_FROM=IntiBelajar <masuk@domain-terverifikasi-kamu.com>
