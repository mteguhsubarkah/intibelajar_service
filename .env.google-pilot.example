# Merge into the server .env. Never use VITE_ prefixes for credentials.
# Requires NODE_ENV=production, RUNTIME_MODE=pilot, public HTTPS APP_ORIGIN.
GOOGLE_OIDC_ENABLED=false
LOCAL_GOOGLE_OIDC=false
GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=REPLACE
# Google Cloud Web application authorized redirect URI:
# https://intibelajar.com/v1/auth/callback/google
