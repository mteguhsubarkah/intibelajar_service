# Copy to .local/local-dev/email.env (npm run local:dev) or merge into .env. Never place secrets in VITE_* or Git.
# Onboarding mandiri: username + kelas mengaktifkan akun tanpa izin guardian.
SELF_ONBOARDING_CONSENT=true
# Email masuk sungguhan lewat Resend (https://resend.com). EMAIL_FROM harus memakai domain
# yang sudah diverifikasi di Resend; untuk uji awal Resend menyediakan onboarding@resend.dev
# (hanya bisa mengirim ke email pemilik akun Resend).
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_REPLACE
EMAIL_FROM=IntiBelajar <masuk@REPLACE.com>
