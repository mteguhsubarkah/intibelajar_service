{
  "name": "intibelajar-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "backoffice": "tsx scripts/backoffice/server.ts",
    "backoffice:worker": "tsx scripts/backoffice/worker.ts",
    "backoffice:seed": "tsx scripts/backoffice/worker.ts --enqueue --once",
    "backoffice:verify": "node scripts/backoffice/verify.mjs",
    "local:dev": "node scripts/local-dev.mjs",
    "local:check": "node scripts/local/smoke.mjs",
    "dev": "node scripts/local-dev.mjs",
    "dev:api": "tsx src/main.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-boundaries.mjs",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "migrate": "tsx src/migrate.ts up",
    "migrate:down": "tsx src/migrate.ts down",
    "validate:contract": "tsx scripts/validate-contract.ts",
    "verify:frontend": "node scripts/verify-frontend.mjs",
    "db:types": "node scripts/generate-db-types.mjs",
    "fixtures": "tsx scripts/fixtures.ts",
    "mailbox": "tsx scripts/read-mailbox.ts",
    "catalog:extract": "tsx scripts/catalog/extract-from-frontend.ts",
    "catalog:check": "tsx scripts/catalog/extract-from-frontend.ts --check",
    "catalog:lint": "tsx scripts/catalog/lint-manifest.ts",
    "catalog:publish": "tsx scripts/catalog/publish.ts",
    "catalog:pilot": "tsx scripts/catalog/pilot.ts",
    "catalog:signoff": "tsx scripts/catalog/sign-off.ts",
    "catalog:golden": "tsx scripts/catalog/golden.ts",
    "catalog:bundle-check": "tsx scripts/catalog/check-bundle-keys.ts",
    "e2e:seed": "tsx scripts/e2e-seed.ts",
    "e2e:canonical": "node scripts/e2e-canonical.mjs",
    "verify:slice1": "node scripts/verify-slice1.mjs",
    "test:catalog": "tsx --test --test-concurrency=1 test/catalog-*.test.ts",
    "pilot:check": "tsx scripts/pilot-readiness.ts"
  },
  "dependencies": {
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "kysely": "0.28.18",
    "openid-client": "6.8.8",
    "pg": "8.23.1",
    "sharp": "0.35.5",
    "swagger-ui-dist": "5.34.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "fast-check": "3.23.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
